# Sentinel AI Security Suite - Environment Template

APP_NAME=Sentinel
APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Africa/Johannesburg

# Enables the local-only PC Support Console during non-production testing.
# It is never reachable from other devices, even when enabled.
SUPPORT_DIAGNOSTICS_ENABLED=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sentinel_ai_security
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

JWT_SECRET=
JWT_ISSUER=sentinel
JWT_TTL_SECONDS=3600

APP_KEY=
ENCRYPTION_KEY=
ENFORCE_HTTPS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIES=false
SESSION_SAME_SITE=lax

MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@sentinel.local
MAIL_FROM_NAME=Sentinel

# Optional local product-help assistant. It has no database, record, code, or
# action access. Ollama must run on the same host and the model must be present.
AI_HELP_ENABLED=false
AI_HELP_BASE_URL=http://127.0.0.1:11434
AI_HELP_MODEL=qwen2.5:0.5b

CACHE_DRIVER=file
CACHE_TTL=3600
QUEUE_DRIVER=sync

LOG_CHANNEL=application
LOG_LEVEL=info

MAX_UPLOAD_SIZE=52428800
# Keep empty for same-origin deployments. Configure an explicit comma-separated allowlist only when cross-origin clients are deployed.
CORS_ALLOWED_ORIGINS=
