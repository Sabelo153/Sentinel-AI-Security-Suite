{
  "name": "sentinel/security-suite",
  "description": "Enterprise Security Management Platform",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "stable",
  "authors": [
    {
      "name": "Sabelo Biyela"
    }
  ],
  "require": {
    "php": "^8.2",
    "lcobucci/jwt": "^5.5",
    "monolog/monolog": "^3.7",
    "paragonie/sodium_compat_ext_sodium": "^1.0",
    "psr/log": "^3.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.1"
  },
  "autoload": {
    "psr-4": {
      "Sentinel\\": "app/"
    },
    "files": [
      "app/Helpers/env.php",
      "app/Helpers/uuid.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Sentinel\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit tests/Unit/",
    "test:integration": "phpunit tests/Integration/",
    "test:coverage": "phpunit --coverage-html storage/reports/coverage/"
  }
}
